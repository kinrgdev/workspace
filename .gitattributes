* text=auto eol=lf 

# LF para código
*.js       text eol=lf
*.html     text eol=lf
*.css      text eol=lf
*.json     text eol=lf

# CRLF solo para scripts Windows
*.bat      text eol=crlf
*.ps1      text eol=crlf
*.cmd      text eol=crlf

# Binarios no deben modificarse
*.png      binary
*.jpg      binary
